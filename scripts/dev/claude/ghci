#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause
#
# ghci -- thin helper around the GitHub Actions REST API (via `gh`) for
# inspecting Tilck CI runs: dispatch, status, per-job results, and failed
# step logs. Dev-only tool for Claude's CI iteration.
#
# The CI workflows carry `branches-ignore: [readme*, temp-*, exp-*]`, so a
# push to a topic branch triggers nothing: runs on exp-* must be dispatched
# explicitly. That is intentional, and it is why `dispatch` exists.
#
# Usage: ghci [-g GROUP] <sub-command> [args]
#
# GROUP selects which workflows every sub-command acts on:
#   all      (default) everything that validates a change
#   tc       the six toolchain workflows (distro x arch)
#   kernel   the three "Tilck <arch>" build+test workflows
#
# The group matters beyond dispatch: a "batch" is the newest run of each
# workflow IN THE GROUP, so `-g tc status` reports on the toolchain runs
# even when a kernel batch was dispatched after them.
#
# Sub-commands:
#   workflows              list the workflows in the selected group
#   dispatch <branch>      trigger the selected workflows on a branch
#   status <branch>        compact table of the selected workflows' runs
#   wait <branch> [secs]   poll until every run in the batch is done
#   jobs <runId>           per-job state/result for one run
#   fails <branch>         failed jobs across the batch
#   log <runId>            failed-step log for one run
#
set -euo pipefail

# Build+test workflows: these boot Tilck in a container image that has to
# carry a matching toolchain, so they are the ones to leave alone while
# the images are stale.
WORKFLOWS_KERNEL=(
   "Tilck i386"
   "Tilck riscv64"
   "Tilck x86_64"
)

# Toolchain workflows: each builds the toolchain from scratch on a stock
# distro image, so they validate pkgmgr without depending on a prebuilt
# Tilck image.
WORKFLOWS_TC=(
   "Toolchain arch i386"
   "Toolchain arch riscv64"
   "Toolchain debian i386"
   "Toolchain debian riscv64"
   "Toolchain fedora i386"
   "Toolchain fedora riscv64"
)

# "Build CI containers" is in neither group: it only ever runs on master
# and rebuilds images rather than testing a change.
WORKFLOWS=( "${WORKFLOWS_KERNEL[@]}" "${WORKFLOWS_TC[@]}" )

select_group() {
   case "$1" in
      all)    WORKFLOWS=( "${WORKFLOWS_KERNEL[@]}" "${WORKFLOWS_TC[@]}" ) ;;
      tc)     WORKFLOWS=( "${WORKFLOWS_TC[@]}" ) ;;
      kernel) WORKFLOWS=( "${WORKFLOWS_KERNEL[@]}" ) ;;
      *)
         echo "ghci: unknown group '$1' (want: all, tc, kernel)" >&2
         exit 1
         ;;
   esac
}

# The batch = the most recent run of each workflow in the group, newest
# first. Selecting by name rather than by "the last N runs on the branch"
# keeps a later dispatch of another group from shifting this one out of
# view, and makes a workflow that was never dispatched visible as missing
# instead of silently shortening the batch.
batch_json() {
   local branch="$1"
   local names
   names=$(printf '%s\n' "${WORKFLOWS[@]}" |
           python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().split("\n")[:-1]))')

   gh run list --branch "$branch" --limit 100 \
      --json databaseId,name,status,conclusion,createdAt,url |
   WANTED="$names" python3 -c '
import json, os, sys
wanted = json.loads(os.environ["WANTED"])
seen, out = set(), []
for r in json.load(sys.stdin):        # gh lists newest first
    if r["name"] in wanted and r["name"] not in seen:
        seen.add(r["name"])
        out.append(r)
json.dump(out, sys.stdout)
'
}

cmd_workflows() {
   printf '%s\n' "${WORKFLOWS[@]}"
}

cmd_dispatch() {
   local branch="${1:?usage: ghci [-g GROUP] dispatch <branch>}"
   local w
   for w in "${WORKFLOWS[@]}"; do
      printf '%-28s ' "$w"
      if gh workflow run "$w" --ref "$branch" >/dev/null 2>&1; then
         echo "dispatched"
      else
         echo "DISPATCH FAILED"
      fi
   done
}

cmd_status() {
   local branch="${1:?usage: ghci [-g GROUP] status <branch>}"
   batch_json "$branch" | EXPECTED="${#WORKFLOWS[@]}" python3 -c '
import json, os, sys
rows = json.load(sys.stdin)
expected = int(os.environ["EXPECTED"])
done = sum(1 for r in rows if r["status"] == "completed")
# A run that has not concluded reports "" or null, not a failure.
bad  = [r for r in rows if r["conclusion"] and r["conclusion"] != "success"]
for r in rows:
    print("  %-28s %-12s %s" % (r["name"], r["status"], r["conclusion"] or ""))
if len(rows) < expected:
    print("  (%d of %d workflows have no run on this branch)"
          % (expected - len(rows), expected))
print("  ---- %d/%d completed, %d not successful ----"
      % (done, expected, len(bad)))
sys.exit(1 if (done == expected and bad) else 0)
'
}

cmd_wait() {
   local branch="${1:?usage: ghci [-g GROUP] wait <branch> [interval]}"
   local interval="${2:-60}"
   local n=${#WORKFLOWS[@]}
   local pending
   while :; do
      pending=$(batch_json "$branch" | EXPECTED="$n" python3 -c '
import json, os, sys
rows = json.load(sys.stdin)
expected = int(os.environ["EXPECTED"])
running = sum(1 for r in rows if r["status"] != "completed")
print(running + (expected - len(rows)))   # a missing run is not done
')
      if [ "$pending" -eq 0 ]; then
         echo "All $n runs completed."
         cmd_status "$branch" || true
         return 0
      fi
      echo "$(date -u +%H:%M:%S)  $pending/$n still running..."
      sleep "$interval"
   done
}

cmd_jobs() {
   local run="${1:?usage: ghci jobs <runId>}"
   gh run view "$run" --json jobs \
      --jq '.jobs[] | "  \(.name)\t\(.status)\t\(.conclusion // "")"' |
      column -t -s $'\t'
}

cmd_fails() {
   local branch="${1:?usage: ghci [-g GROUP] fails <branch>}"
   local ids
   ids=$(batch_json "$branch" | python3 -c '
import json, sys
for r in json.load(sys.stdin):
    if r["conclusion"] and r["conclusion"] != "success":
        print(r["databaseId"], r["name"].replace(" ", "_"), r["conclusion"])
')
   if [ -z "$ids" ]; then
      echo "No failed runs in the batch."
      return 0
   fi
   local id name concl
   while read -r id name concl; do
      echo "=== $id  ${name//_/ }  [$concl] ==="
      gh run view "$id" --json jobs \
         --jq '.jobs[] | select(.conclusion != "success" and .conclusion != null) | "  job: \(.name) -> \(.conclusion)"' \
         2>/dev/null || true
   done <<< "$ids"
}

cmd_log() {
   local run="${1:?usage: ghci log <runId>}"
   gh run view "$run" --log-failed 2>/dev/null || {
      echo "No failed-step log (run may still be in progress)."
      return 1
   }
}

if [ "${1:-}" = "-g" ]; then
   select_group "${2:?usage: ghci -g GROUP <sub-command> [args]}"
   shift 2
fi

case "${1:-}" in
   workflows) shift; cmd_workflows "$@" ;;
   dispatch)  shift; cmd_dispatch  "$@" ;;
   status)    shift; cmd_status    "$@" ;;
   wait)      shift; cmd_wait      "$@" ;;
   jobs)      shift; cmd_jobs      "$@" ;;
   fails)     shift; cmd_fails     "$@" ;;
   log)       shift; cmd_log       "$@" ;;
   *)
      sed -n '3,30p' "$0"
      exit 1
      ;;
esac
