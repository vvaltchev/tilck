#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause
#
# pmprof -- a sampling profiler for the Ruby package manager.
#
# The pkgmgr's Ruby has no profiler gem, and a deterministic tracer
# distorts exactly the thing being measured: a run made of many cheap
# calls looks like a run made of a few expensive ones. So this samples
# instead -- a second thread reads the main thread's backtrace every
# INTERVAL and counts what it finds.
#
# Two numbers per frame, and they answer different questions:
#
#   SELF   the samples where this frame was on top: time spent IN it
#   TOTAL  the samples where it appeared anywhere: time spent UNDER it
#
# A caller with a large TOTAL and a small SELF is not slow; something
# it calls is. Only SELF says "the time is here".
#
# Usage: pmprof [-i SECONDS] [-n TOP] [-r RUNS] [--] [args for main.rb]
#
# With no args it profiles `-l -q`, the listing everyone waits for.
#
#   -i  sampling interval, default 0.0005. Ruby's sleep will not give
#       you much better than this, and the header reports the rate
#       that was actually ACHIEVED rather than the one asked for.
#   -r  run the workload this many times in one process. One run of a
#       fast command yields too few samples to say anything; repeating
#       it is how the profile gets a population. Note that `require`
#       happens once however many runs there are, so its share falls
#       as -r rises -- which is the point when you want steady state
#       rather than start-up.
#   -n  how many frames to print. Whatever is left is reported as one
#       "other" row with its own share, so the column always sums to
#       100% and a reader can see how much is in the tail.
#
# The workload's stdout goes to /dev/null: profiling a listing that is
# also painting a terminal measures the terminal.
#
set -euo pipefail

TILCK_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
INTERVAL=0.0005
TOP=20
RUNS=1

while [ $# -gt 0 ]; do
   case "$1" in
      -i) INTERVAL="$2"; shift 2 ;;
      -n) TOP="$2"; shift 2 ;;
      -r) RUNS="$2"; shift 2 ;;
      --) shift; break ;;
      -h|--help|help)
         sed -n '/^# Usage:/,/^#$/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
         exit 0
         ;;
      *) break ;;
   esac
done

[ $# -gt 0 ] || set -- -l -q

find_ruby() {
   local pkgs r
   pkgs=$("$TILCK_ROOT/scripts/build_toolchain" --print-layout 2>/dev/null |
          sed -n 's/^PKGS_HOST_DISTRO=//p' | tail -1)
   for r in "$pkgs"/ruby/*/bin/ruby; do
      [ -x "$r" ] && { echo "$r"; return 0; }
   done
   echo "pmprof: no pkgmgr ruby under $pkgs" >&2
   return 1
}

INTERVAL="$INTERVAL" TOP="$TOP" RUNS="$RUNS" ROOT="$TILCK_ROOT" "$(find_ruby)" -e '
interval = ENV["INTERVAL"].to_f
top      = ENV["TOP"].to_i
runs     = [ENV["RUNS"].to_i, 1].max
root     = ENV["ROOT"]

main_thread = Thread.current
samples = []
running = true

# The sampler reads the MAIN thread, so its own work never appears in
# the profile.
sampler = Thread.new do
  while running
    begin
      locs = main_thread.backtrace_locations
      samples << locs if locs && !locs.empty?
    rescue StandardError
      # A thread can be between frames; a lost sample is noise, not a
      # reason to stop profiling.
    end
    sleep interval
  end
end

t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)

# Required INSIDE the measured region: loading and registering the
# packages is part of what a run costs, and profiling only what comes
# after would hide a third of the answer.
# $0 is left alone ON PURPOSE. main.rb ends with
#
#   if __FILE__ == $0
#     exit Main::main(ARGV)
#   end
#
# so pointing $0 at it makes the require itself run the command and
# exit -- which silently reduced every -r to a single run.
real_stdout = STDOUT.dup
STDOUT.reopen(File::NULL, "w")

begin
  require root + "/scripts/pkgmgr/main.rb"
  runs.times { Main.main(ARGV.dup) }
rescue SystemExit
end

STDOUT.reopen(real_stdout)
elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
running = false
sampler.join

def frame_name(loc, root)
  path = loc.path.to_s.sub(root + "/", "")
  "#{path}:#{loc.lineno}  #{loc.label}"
end

self_count  = Hash.new(0)
total_count = Hash.new(0)

for st in samples do
  self_count[frame_name(st.first, root)] += 1
  seen = {}
  for loc in st do
    n = frame_name(loc, root)
    next if seen[n]
    seen[n] = true
    total_count[n] += 1
  end
end

n = samples.length
pct = ->(c) { n.zero? ? 0.0 : 100.0 * c / n }

puts
puts "samples: #{n}   runs: #{runs}   wall: #{"%.2f" % elapsed}s"
puts "asked for one sample every #{interval}s, got one every " \
     "#{n.zero? ? "-" : "%.2f" % (elapsed * 1000 / n)}ms"
puts

# Whatever does not fit in the top N is reported as one row rather
# than dropped: a column of percentages that does not add up invites
# the reader to assume the rest is nothing.
show = ->(title, counts) {
  puts title
  rows = counts.sort_by { |_, c| -c }
  head = rows.first(top)

  head.each { |name, c| printf("  %5.1f%%  %5d  %s\n", pct.call(c), c, name) }

  tail = rows.drop(top)
  if !tail.empty?
    printf("  %5.1f%%  %5d  (%d more frames)\n",
           pct.call(tail.sum { |_, c| c }), tail.sum { |_, c| c },
           tail.length)
  end

  printf("  %5.1f%%  %5d  TOTAL\n",
         pct.call(rows.sum { |_, c| c }), rows.sum { |_, c| c })
}

show.call("== SELF (time spent in this frame) ==", self_count)
puts
show.call("== TOTAL (time spent under this frame; frames nest, so " \
          "this over-counts) ==", total_count)
' -- "$@"
